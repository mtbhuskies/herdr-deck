{
  "name": "herdr-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "pack": "streamdeck pack com.mtbhuskies.herdr-deck.sdPlugin --output dist --force",
    "validate": "streamdeck validate com.mtbhuskies.herdr-deck.sdPlugin",
    "smoke": "node scripts/smoke.mjs && node scripts/fake-deck.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "22.20.5",
    "rollup": "4.67.4",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
